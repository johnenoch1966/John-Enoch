<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Enterprise Agentic AI Adoption: Drivers &amp; Inhibitors</title>
<style>
  :root {
    --bg: #f5f7fa; --card: #fff; --ink: #1f2933; --muted: #5f6b7a; --line: #e3e8ee;
    --accent: #1a73e8; --good: #188038; --bad: #c5221f; --warn: #b06000;
    --copilot: #1a73e8; --copilot-bg: #e8f0fe; --workflow: #7b1fa2; --workflow-bg: #f3e5f5;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
         background: var(--bg); color: var(--ink); }
  header { background: linear-gradient(120deg, #0b3d91, #1a73e8); color: #fff; padding: 28px 24px; }
  header h1 { margin: 0 0 4px; font-size: 26px; }
  header p { margin: 0; opacity: .9; font-size: 14px; }
  main { max-width: 1240px; margin: 0 auto; padding: 20px 24px; }
  nav { position: sticky; top: 0; z-index: 5; background: var(--bg); padding: 10px 0;
        display: flex; flex-wrap: wrap; gap: 8px; }
  nav a { background: #fff; border: 1px solid var(--line); border-radius: 999px; padding: 4px 12px;
          color: var(--accent); text-decoration: none; font-size: 13px; }
  section { background: var(--card); border: 1px solid var(--line); border-radius: 14px;
            padding: 20px 24px; margin-bottom: 20px; }
  h2 { margin: 0 0 4px; font-size: 20px; }
  .sub { color: var(--muted); margin: 0 0 16px; font-size: 14px; }
  h3 { font-size: 15px; margin: 18px 0 8px; text-transform: uppercase; letter-spacing: .04em; color: var(--muted); }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 8px; }
  .kpi { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
  .kpi b { display: block; font-size: 22px; }
  .kpi span { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .04em; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  th { background: #f1f3f4; font-weight: 600; font-size: 12px; text-transform: uppercase; letter-spacing: .03em; color: var(--muted); }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  @media (max-width: 900px) { .grid2, .grid3 { grid-template-columns: 1fr; } }
  .card { border: 1px solid var(--line); border-radius: 12px; padding: 14px 16px; background: #fff; }
  .card h4 { margin: 0 0 2px; font-size: 15px; }
  .card .meta { color: var(--muted); font-size: 12px; margin-bottom: 8px; }
  .card ol { margin: 0; padding-left: 20px; }
  .card li { margin: 4px 0; font-size: 14px; }
  .badge { display: inline-block; padding: 1px 8px; border-radius: 999px; font-size: 11px; font-weight: 600;
           background: #eef1f4; color: var(--muted); white-space: nowrap; vertical-align: middle; }
  .seg-copilot { background: var(--copilot-bg); color: var(--copilot); }
  .seg-workflow { background: var(--workflow-bg); color: var(--workflow); }
  .rc { background: #eef3fd; color: #174ea6; font-weight: 500; }
  .st-mainstream { background: #e6f4ea; color: var(--good); }
  .st-scaling { background: #e8f0fe; color: #174ea6; }
  .st-piloting { background: #fef7e0; color: var(--warn); }
  .st-experimenting { background: #f1f3f4; color: var(--muted); }
  .strong { background: #e6f4ea; color: var(--good); }
  .moderate { background: #fef7e0; color: var(--warn); }
  .weak, .thin { background: #f1f3f4; color: var(--muted); }
  .new { background: #fce8e6; color: var(--bad); }
  .bar { position: relative; height: 10px; width: 110px; background: #eef1f4; border-radius: 6px; display: inline-block; vertical-align: middle; }
  .bar i { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 6px; background: linear-gradient(90deg, #34a853, #188038); }
  .score { font-weight: 700; margin-left: 6px; font-variant-numeric: tabular-nums; }
  .rank { font-weight: 700; color: var(--muted); width: 32px; }
  .cite { font-size: 11px; color: var(--accent); text-decoration: none; margin-right: 2px; }
  .muted { color: var(--muted); }
  .small { font-size: 12px; }
  .list { list-style: none; margin: 0; padding: 0; counter-reset: n; }
  .list li { counter-increment: n; padding: 8px 0 8px 34px; border-bottom: 1px solid var(--line); position: relative; }
  .list li::before { content: counter(n); position: absolute; left: 0; top: 8px; width: 24px; height: 24px; border-radius: 50%;
                     text-align: center; line-height: 24px; font-size: 12px; font-weight: 700; color: #fff; background: var(--muted); }
  .list.good li::before { background: var(--good); }
  .list.bad li::before { background: var(--bad); }
  .list.act li::before { background: var(--accent); }
  .list b { display: block; }
  .panel-head { padding: 10px 14px; border-radius: 10px; font-weight: 700; margin-bottom: 4px; }
  .ph-good { background: #e6f4ea; color: var(--good); }
  .ph-bad { background: #fce8e6; color: var(--bad); }
  .ph-act { background: #e8f0fe; color: #174ea6; }
  .picker { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; align-items: center; }
  .picker button { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 6px 14px; cursor: pointer; font: inherit; font-size: 14px; }
  .picker button.active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .ind-panel { display: none; }
  .ind-panel.active { display: block; }
  .headline { font-size: 16px; margin: 0 0 14px; }
  details summary { cursor: pointer; font-weight: 600; margin: 6px 0; }
  .heat td.n { text-align: center; font-variant-numeric: tabular-nums; }
  .arrow { color: var(--muted); padding: 0 4px; }
  blockquote { margin: 4px 0; padding-left: 10px; border-left: 3px solid var(--line); color: var(--muted); }
  footer { text-align: center; color: var(--muted); font-size: 12px; padding: 24px; }
</style>
</head>
<body>
{% set s = r.synthesis %}
{% set seg_titles = {"copilot": "Copilot / desktop agentic assistants", "workflow": "Workflow-specific agents"} %}
{% set seg_subs = {
  "copilot": "Gemini, Microsoft 365 Copilot, Claude, ChatGPT Enterprise used across the workforce. Use cases ranked by realised business impact.",
  "workflow": "Agents embedded in business processes (KYC, claims, service desk, complaints, contact centre, ...). Use cases ranked by realised business impact."} %}
{% macro cites(ids) -%}{%- for i in ids[:4] %}<a class="cite" href="#e{{ i }}">[{{ i }}]</a>{% endfor -%}{%- endmacro %}
{% macro rc(id) -%}<span class="badge rc">{{ r.taxonomy.get(id, id) }}</span>{%- endmacro %}
{% macro segbadge(seg) -%}<span class="badge seg-{{ seg }}">{{ "Copilot" if seg == "copilot" else "Workflow" }}</span>{%- endmacro %}

<header>
  <h1>Enterprise Agentic AI Adoption</h1>
  <p>What drives and blocks adoption of Gemini, Copilot, Claude and workflow agents in large enterprises &middot;
     updated {{ r.generated_at[:10] }} &middot; run <code>{{ r.run_id }}</code></p>
</header>
<main>
<nav>
  <a href="#by-industry">Use cases by industry</a>
  <a href="#copilot">Copilot assistants</a>
  <a href="#workflow">Workflow agents</a>
  <a href="#industry">Industry deep-dive</a>
  <a href="#bias">Semantic bias</a>
  <a href="#changes">What changed</a>
  <a href="#evidence">Evidence &amp; method</a>
</nav>

<div class="kpis">
  <div class="kpi"><b>{{ r.catalog.use_cases|length if r.catalog else 0 }}</b><span>Use cases tracked</span></div>
  <div class="kpi"><b>{{ r.stats.sources_total }}</b><span>Public sources</span></div>
  <div class="kpi"><b>{{ r.stats.claims_total }}</b><span>Evidence claims</span></div>
  <div class="kpi"><b>{{ r.industry_views|length }}</b><span>Industries profiled</span></div>
  <div class="kpi"><b>{{ (r.stats.vendor_source_share * 100)|round|int }}%</b><span>Vendor-affiliated evidence</span></div>
</div>

<!-- (ii) Use cases by industry -->
<section id="by-industry">
  <h2>Top AI use cases by industry</h2>
  <p class="sub">Most widely deployed agentic AI use cases per industry. {{ segbadge("copilot") }} = desktop assistant use &middot; {{ segbadge("workflow") }} = process-embedded agent.</p>
  <div class="cards">
  {% for ind in r.industry_views %}
    <div class="card">
      <h4>{{ ind.name }}</h4>
      <div class="meta">{{ ind.claim_count }} industry-specific claims</div>
      <ol>{% for u in ind.top_use_cases %}<li>{{ u.name }} {{ segbadge(u.segment) }}</li>{% else %}<li class="muted">No data yet</li>{% endfor %}</ol>
    </div>
  {% endfor %}
  </div>
</section>

<!-- (iii) + (iv) Segments ranked by impact -->
{% for seg in s.segments %}{% set view = r.segment_views.get(seg.segment, {"ranked": [], "not_assessed": []}) %}
<section id="{{ seg.segment }}">
  <h2>{{ seg_titles.get(seg.segment, seg.segment) }} {{ segbadge(seg.segment) }}</h2>
  <p class="sub">{{ seg_subs.get(seg.segment, "") }}</p>
  <p class="headline"><strong>{{ seg.headline }}</strong></p>
  <table>
    <tr><th>#</th><th>Use case</th><th>Impact</th><th>Adoption stage</th><th>Main value</th><th>Main blocker</th><th>Evidence</th></tr>
    {% for u in view.ranked %}
    {% if loop.index == 13 %}</table><details><summary>Show {{ view.ranked|length - 12 }} more use cases</summary><table>
    <tr><th>#</th><th>Use case</th><th>Impact</th><th>Adoption stage</th><th>Main value</th><th>Main blocker</th><th>Evidence</th></tr>{% endif %}
    <tr>
      <td class="rank">{{ loop.index }}</td>
      <td><strong>{{ u.name }}</strong></td>
      <td style="white-space:nowrap"><span class="bar"><i style="width: {{ u.impact_score * 20 }}%"></i></span><span class="score">{{ u.impact_score }}/5</span></td>
      <td><span class="badge st-{{ u.adoption_stage }}">{{ u.adoption_stage }}</span></td>
      <td>{{ u.value_lever }}</td>
      <td class="muted">{{ u.key_blocker }}</td>
      <td class="small">{{ u.evidence_count }} {{ cites(u.evidence_ids) }}</td>
    </tr>
    {% endfor %}
  </table>{% if view.ranked|length > 12 %}</details>{% endif %}
  {% if view.not_assessed %}<p class="small muted">Not yet assessed (insufficient evidence): {{ view.not_assessed|join(", ") }}</p>{% endif %}

  <div class="grid2">
    <div><h3>Top adoption drivers</h3>
      <ol class="list good">{% for f in seg.top_drivers %}<li><b>{{ f.factor }} <span class="badge {{ f.strength }}">{{ f.strength }}</span></b>
        <span class="small muted">{{ f.explanation }}</span> {{ rc(f.root_cause_id) }} {{ cites(f.evidence_ids) }}</li>{% endfor %}</ol>
    </div>
    <div><h3>Top adoption blockers</h3>
      <ol class="list bad">{% for f in seg.top_inhibitors %}<li><b>{{ f.factor }} <span class="badge {{ f.strength }}">{{ f.strength }}</span></b>
        <span class="small muted">{{ f.explanation }}</span> {{ rc(f.root_cause_id) }} {{ cites(f.evidence_ids) }}</li>{% endfor %}</ol>
    </div>
  </div>
  <div class="grid2">
    <div><h3>What high-adoption enterprises do</h3>
      <ol class="list act">{% for a in seg.high_adoption_approaches %}<li><b>{{ a.approach }}</b><span class="small muted">{{ a.rationale }}</span> {{ cites(a.evidence_ids) }}</li>{% endfor %}</ol>
    </div>
    <div><h3>Patterns behind low adoption</h3>
      <ol class="list">{% for a in seg.low_adoption_patterns %}<li><b>{{ a.approach }}</b><span class="small muted">{{ a.rationale }}</span> {{ cites(a.evidence_ids) }}</li>{% endfor %}</ol>
    </div>
  </div>
</section>
{% endfor %}

<!-- (v) Industry deep-dive with picker -->
<section id="industry">
  <h2>Industry deep-dive</h2>
  <p class="sub">Pick an industry to see its top 5 adoption drivers, top 5 blockers and the 5 actions most associated with success.</p>
  <div class="picker" role="tablist">
    {% for ind in r.industry_views %}<button type="button" data-ind="{{ ind.id }}" class="{{ 'active' if loop.first }}" role="tab">{{ ind.name.split(' (')[0] if '(' not in ind.name else ind.name.split('(')[1].rstrip(')') }}</button>{% endfor %}
  </div>
  {% for ind in r.industry_views %}{% set p = ind.profile %}
  <div class="ind-panel {{ 'active' if loop.first }}" id="ind-{{ ind.id }}" role="tabpanel">
    <h3 style="margin-top:0">{{ ind.name }}</h3>
    {% if p %}
    <p class="headline"><strong>{{ p.headline }}</strong> <span class="badge {{ p.evidence_strength }}">evidence: {{ p.evidence_strength }}</span>
      <span class="small muted">({{ ind.claim_count }} industry-specific claims)</span></p>
    <div class="grid3">
      <div><div class="panel-head ph-good">Top 5 adoption drivers</div>
        <ol class="list good">{% for d in p.drivers[:5] %}<li><b>{{ d.point }}</b><span class="small muted">{{ d.detail }}</span> {{ rc(d.root_cause_id) }} {{ cites(d.evidence_ids) }}</li>{% endfor %}</ol></div>
      <div><div class="panel-head ph-bad">Top 5 blockers</div>
        <ol class="list bad">{% for d in p.blockers[:5] %}<li><b>{{ d.point }}</b><span class="small muted">{{ d.detail }}</span> {{ rc(d.root_cause_id) }} {{ cites(d.evidence_ids) }}</li>{% endfor %}</ol></div>
      <div><div class="panel-head ph-act">Advice: 5 actions to drive success</div>
        <ol class="list act">{% for a in p.advice[:5] %}<li><b>{{ a.action }}</b><span class="small muted">{{ a.rationale }}</span> {{ cites(a.evidence_ids) }}</li>{% endfor %}</ol></div>
    </div>
    {% else %}<p class="muted">No profile yet for this industry; it will appear after the next research run.</p>{% endif %}
  </div>
  {% endfor %}
</section>

<section id="bias">
  <h2>Semantic bias: what reports say vs what is really going on</h2>
  <p class="sub">Reports often describe a symptom. Each row maps the stated framing to the most likely underlying cause.</p>
  <table>
    <tr><th>As reported</th><th></th><th>Underlying issue</th><th>Root cause</th><th>So what</th></tr>
    {% for b in s.semantic_bias_insights %}
    <tr><td>&ldquo;{{ b.stated_framing }}&rdquo;</td><td class="arrow">&rarr;</td><td>{{ b.underlying_issue }} {{ cites(b.evidence_ids) }}</td>
      <td>{{ rc(b.root_cause_id) }}</td><td class="muted">{{ b.implication }}</td></tr>
    {% endfor %}
  </table>
  {% if s.source_bias_notes %}<p class="small muted"><strong>Source bias:</strong> {{ s.source_bias_notes|join(" · ") }}</p>{% endif %}
</section>

<section id="changes">
  <h2>What changed since the last run</h2>
  <p>{{ s.change_since_last_run }}</p>
  {% if not r.diff.first_run %}
  <details><summary>Factor and theme changes</summary>
  <table>
    <tr><th>Segment</th><th>Type</th><th>New factors</th><th>Root-cause themes</th></tr>
    {% for seg, d in r.diff.segments.items() %}{% for key, label in [("top_drivers","Drivers"),("top_inhibitors","Blockers")] %}
    <tr><td>{{ seg_titles.get(seg, seg) }}</td><td>{{ label }}</td>
      <td>{% for f in d[key].new %}<span class="badge new">{{ f }}</span> {% else %}<span class="muted">none</span>{% endfor %}</td>
      <td>{% for t in d[key].get("new_themes", []) %}<span class="badge new">+ {{ t }}</span> {% endfor %}
        {% for t in d[key].get("dropped_themes", []) %}<span class="badge weak">&minus; {{ t }}</span> {% endfor %}
        {% if not d[key].get("new_themes") and not d[key].get("dropped_themes") %}<span class="muted">unchanged</span>{% endif %}</td></tr>
    {% endfor %}{% endfor %}
  </table></details>
  {% endif %}
  <details><summary>Root-cause heatmap (all evidence)</summary>
  {% set mx = namespace(v=1) %}
  {% for row in r.root_cause_matrix %}{% for k in ["copilot_driver","copilot_inhibitor","workflow_driver","workflow_inhibitor"] %}{% if row[k] > mx.v %}{% set mx.v = row[k] %}{% endif %}{% endfor %}{% endfor %}
  <table class="heat">
    <tr><th>Root cause</th><th>Copilot drivers</th><th>Copilot blockers</th><th>Workflow drivers</th><th>Workflow blockers</th></tr>
    {% for row in r.root_cause_matrix %}<tr><td>{{ row.name }}</td>
      {% for k, hue in [("copilot_driver","24,128,56"),("copilot_inhibitor","197,34,31"),("workflow_driver","24,128,56"),("workflow_inhibitor","197,34,31")] %}
      <td class="n" style="background: rgba({{ hue }}, {{ (row[k] / mx.v * 0.6)|round(2) }})">{{ row[k] }}</td>{% endfor %}</tr>{% endfor %}
  </table></details>
</section>

<section id="evidence">
  <h2>Evidence &amp; method</h2>
  <p class="sub">A multi-agent ADK pipeline: a scoping agent selects the top {{ r.catalog.use_cases|length if r.catalog else 50 }} deployed use cases; parallel researchers
  (per use-case cluster and per industry) read public reports and record cited claims; a semantic-bias analyst maps each claim to a root cause and
  industry; segment and industry analysts rank findings; a critic validates every citation. Evidence accumulates across runs.</p>
  <details><summary>All cited evidence ({{ r.evidence|length }} claims)</summary>
  <table>
    <tr><th>#</th><th>Claim</th><th>Source</th><th>Root cause / industries</th></tr>
    {% for e in r.evidence %}
    <tr id="e{{ e.id }}"><td>{{ e.id }}</td>
      <td><span class="badge {{ 'strong' if e.polarity == 'driver' else 'new' }}">{{ e.polarity }}</span> {{ segbadge(e.segment) }}
        <strong>{{ e.stated_factor }}</strong>{% if e.statistic %} <em class="small">({{ e.statistic }})</em>{% endif %}
        <blockquote class="small">{{ e.evidence_quote }}</blockquote></td>
      <td class="small"><a href="{{ e.url }}" target="_blank" rel="noopener">{{ e.title or e.url }}</a><br>
        <span class="muted">{{ e.publisher }} &middot; {{ e.published }} &middot; {{ e.source_type }}</span>
        {% if e.vendor_affiliated %} <span class="badge moderate">vendor</span>{% endif %}</td>
      <td class="small">{% for rid in e.root_cause_ids %}{{ rc(rid) }} {% endfor %}<br><span class="muted">{{ e.industries|join(", ") }}</span></td></tr>
    {% endfor %}
  </table></details>
  {% if s.open_questions %}<details><summary>Open questions for the next research cycle</summary><ul>{% for q in s.open_questions %}<li>{{ q }}</li>{% endfor %}</ul></details>{% endif %}
  {% if history %}<details><summary>Run history</summary>
  <table><tr><th>Run</th><th>Generated</th><th>Sources (new)</th><th>Claims (new)</th></tr>
    {% for h in history|reverse %}<tr><td><a href="history/{{ h.run_id }}.html">{{ h.run_id }}</a></td><td>{{ h.generated_at }}</td>
      <td>{{ h.sources_total }} ({{ h.sources_new }})</td><td>{{ h.claims_total }} ({{ h.claims_new }})</td></tr>{% endfor %}
  </table></details>{% endif %}
  <p class="small muted">Model: {{ r.model }} &middot; invalid citations removed this run: {{ r.stats.citations_dropped }}</p>
</section>
</main>
<footer>Generated by the Enterprise Agentic AI Adoption Research Agent &middot; public sources only &middot; machine-generated; verify against cited evidence.</footer>
<script>
  document.querySelectorAll('.picker button').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.picker button').forEach(function (b) { b.classList.remove('active'); });
      document.querySelectorAll('.ind-panel').forEach(function (p) { p.classList.remove('active'); });
      btn.classList.add('active');
      document.getElementById('ind-' + btn.dataset.ind).classList.add('active');
      history.replaceState(null, '', '#industry-' + btn.dataset.ind);
    });
  });
  var m = location.hash.match(/^#industry-(.+)$/);
  if (m) { var b = document.querySelector('.picker button[data-ind="' + m[1] + '"]'); if (b) { b.click(); b.scrollIntoView(); } }
</script>
</body>
</html>
